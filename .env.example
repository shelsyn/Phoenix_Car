# Copia este archivo como .env.local (en tu PC) y llena los valores.
# En Vercel van en: Project → Settings → Environment Variables.
# NUNCA subas .env.local a git.

# ─── WhatsApp Cloud API (Meta) ───
# Token permanente de un "usuario del sistema" con permiso whatsapp_business_messaging
WHATSAPP_TOKEN=
# WhatsApp → Configuración de la API → "Identificador de número de teléfono"
WHATSAPP_PHONE_NUMBER_ID=
# Texto secreto que tú inventas; se pone igual en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# Configuración de la app → Básica → "Clave secreta de la app"
WHATSAPP_APP_SECRET=
# Opcional: versión de la API de Meta
# WHATSAPP_API_VERSION=v23.0

# ─── Base de datos gratis: Upstash Redis (obligatoria en producción) ───
# Vercel las crea solas al agregar "Upstash for Redis" en Storage. Sin ellas el bot no recuerda la conversación.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Contenido ───
SITE_URL=https://ventrentall.com
# URL oficial de la política de tratamiento de datos (pendiente P-01)
POLITICA_DATOS_URL=https://ventrentall.com/terminos

# ─── Especialistas y notificaciones ───
# Especialistas (si no se cargan en la tabla `especialistas`). "servicios": 1..5, vacío = todos
# ESPECIALISTAS_JSON=[{"id":"ana","nombre":"Ana Pérez","telefono":"573001112233","email":"ana@ventrentall.com","servicios":[1,2,4]}]
# URL que recibe un POST por cada solicitud / pedido de asesor. Gratis con Google Sheets:
# docs/chatbot/google-sheets-apps-script.gs  →  https://script.google.com/.../exec?secreto=TU-SECRETO
NOTIFICACIONES_WEBHOOK_URL=
# Opcional: se envía en el encabezado X-Chatbot-Secreto para que el receptor valide el origen
NOTIFICACIONES_WEBHOOK_SECRETO=

# ─── Tiempos de sesión (opcionales) ───
# CHATBOT_MIN_REANUDAR=60
# CHATBOT_HORAS_ABANDONO=24
# CHATBOT_HORAS_HUMANO=12

# ─── Solo pruebas locales ───
# WHATSAPP_DRY_RUN=1   (no envía mensajes; los muestra en la consola)
